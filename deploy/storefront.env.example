# Taxel storefront (v8-storefront) runtime environment
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_MAX_CONNECTIONS=5

# Platform (admin) URL — used for AI proxying (triage / pharmacist advisor) and widget embed
PLATFORM_URL=https://platform-talksell.ir
NEXT_PUBLIC_PLATFORM_URL=https://platform-talksell.ir
NEXT_PUBLIC_MARKETING_URL=https://talksell.ir
STOREFRONT_BASE_DOMAIN=tsll.ir
NEXT_PUBLIC_STOREFRONT_BASE_DOMAIN=tsll.ir

# AI (storefront calls the gateway directly for sub-second triage responses)
AI_PROVIDER=arvan
ARVAN_API_URL=https://arvancloudai.ir/gateway/models/<MODEL>/<GATEWAY_TOKEN>/v1
ARVAN_API_KEY=<ARVAN_ACCESS_KEY>
ARVAN_MODEL=Xerxes-1
DEEPSEEK_API_KEY=
