# ─────────────────────────────────────────────────────────────────────────────
# Taxel platform (v8) runtime environment
# Copy to deploy/platform.env (git-ignored) and fill in the real values:
#   cp deploy/platform.env.example deploy/platform.env
# docker compose in v8/ loads ../deploy/platform.env automatically; for local dev
# copy the same file to v8/.env.local
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (Chabokan) — every query in both apps runs against this database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
PGHOST=HOST
PGPORT=5432
PGUSER=postgres
PGPASSWORD=PASSWORD
PGDATABASE=DATABASE
POSTGRES_MAX_CONNECTIONS=5

# AI — ArvanCloud is the primary provider, DeepSeek is the switchable fallback
AI_PROVIDER=arvan
AI_FALLBACK_ENABLED=true
ARVAN_API_URL=https://arvancloudai.ir/gateway/models/<MODEL>/<GATEWAY_TOKEN>/v1
ARVAN_API_KEY=<ARVAN_ACCESS_KEY>
ARVAN_MODEL=Xerxes-1
DEEPSEEK_API_KEY=

# URLs
NEXT_PUBLIC_APP_URL=https://platform-talksell.ir
APP_URL=https://platform-talksell.ir
STOREFRONT_BASE_DOMAIN=tsll.ir
NEXT_PUBLIC_STOREFRONT_BASE_DOMAIN=tsll.ir

# Admin account created by `npm run db:setup`
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=<choose-a-strong-password>
ADMIN_FIRST_NAME=مدیر
ADMIN_LAST_NAME=تاکسل
ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=<choose-a-strong-password>

# Instagram / Meta app (fill after creating the Meta app — see docs/instagram-setup.md)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=taxel-instagram-verify
INSTAGRAM_TOKEN_ENCRYPTION_KEY=change-me-32-chars-minimum-secret-key

# WordPress site that hosts the Taxel builder plugin
WORDPRESS_SITE_URL=https://talksell.ir
NODE_OPTIONS=--max-old-space-size=768
